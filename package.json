{
  "name": "@klixsoft/react-native-fonepay",
  "version": "0.1.0-beta.1",
  "description": "Fonepay Intent (bank-app deep link) payments for React Native: bank deep links, live payment watching and a React hook. No WebView, no native code.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "CHANGELOG.md",
    "src",
    "docs",
    "!**/__tests__"
  ],
  "keywords": [
    "react-native",
    "fonepay",
    "payment",
    "payment-gateway",
    "nepal",
    "intent",
    "qr",
    "deeplink"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import ./__tests__/register.mjs --test __tests__/",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klixsoft/react-native-fonepay.git"
  },
  "bugs": {
    "url": "https://github.com/klixsoft/react-native-fonepay/issues"
  },
  "homepage": "https://github.com/klixsoft/react-native-fonepay#readme",
  "author": "Klixsoft",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.70.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "^19.2.18",
    "react": "19.2.8",
    "react-native": "0.87.1",
    "typescript": "^5.9.3"
  }
}
